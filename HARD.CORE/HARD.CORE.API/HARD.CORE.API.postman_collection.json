{
  "info": {
    "_postman_id": "hardcore-api-collection",
    "name": "HARD.CORE.API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection for testing all endpoints in HARD.CORE.API"
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"your_username\",\n  \"password\": \"your_password\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/Auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "Auth", "login"]
        }
      },
        "response": [],
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "/****************************************************************************/",
                "pm.test(\"El campo 'success' es 'true'\", function () {",
                "    let jsonData = pm.response.json();",
                "    pm.collectionVariables.set(\"jwtToken\", jsonData.data);",
                "    pm.expect(jsonData.success).to.eql(true);",
                "});",
                "/****************************************************************************/",
                "// Schema validation",
                "const schema = {",
                "  type: 'object',",
                "  properties: {",
                "    success: { type: 'boolean' },",
                "    message: { type: 'string' },",
                "    data: { type: 'string' },",
                "    errors: { type: 'array' }",
                "  },",
                "  required: ['success', 'message', 'data', 'errors']",
                "};",
                "pm.test(\"Response matches schema\", function () {",
                "  pm.response.to.have.jsonSchema(schema);",
                "});"
              ]
            }
          }
        ]
    },
    {
      "name": "Usuario - GetById",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/Usuario/GetById?idUsuario=1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "Usuario", "GetById"],
          "query": [
            { "key": "idUsuario", "value": "1" }
          ]
        }
      },
        "response": [],
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "// Schema validation",
                "const schema = {",
                "  type: 'object',",
                "  properties: {",
                "    success: { type: 'boolean' },",
                "    message: { type: 'string' },",
                "    data: {},",
                "    errors: { type: 'array' }",
                "  },",
                "  required: ['success', 'message', 'data', 'errors']",
                "};",
                "pm.test(\"Response matches schema\", function () {",
                "  pm.response.to.have.jsonSchema(schema);",
                "});"
              ]
            }
          }
        ]
    },
